 },
 {
  "de": "Kommt zurück. Gegner rutschen aus.",
  "quelle": "daten"
 },
 {
  "de": "Wurfsterne",
  "quelle": "daten"
 },
 {
  "de": "Funkeln. Stechen. Ätzen.",
  "quelle": "daten"
 },
 {
  "de": "Faule Eier",
  "quelle": "daten"
 },
 {
  "de": "Schon drei Wochen alt. Die Wirkung ist enorm.",
  "quelle": "daten"
 },
 {
  "de": "Wasserbombe",
  "quelle": "daten"
 },
 {
  "de": "Sommer, Sonne, Kettenblitz.",
  "quelle": "daten"
 },
 {
  "de": "Hühnerkanone",
  "quelle": "daten"
 },
 {
  "de": "Hühner hüpfen 3× und explodieren bei jedem Aufprall.",
  "quelle": "daten"
 },
 {
  "de": "Partykanone",
  "quelle": "daten"
 },
 {
  "de": "Überraschungsparty! Niemand ist überrascht, alle sind verwirrt.",
  "quelle": "daten"
 },
 {
  "de": "Sternschnuppenstab",
  "quelle": "daten"
 },
 {
  "de": "Wünsch dir was. Zum Beispiel: weniger Gegner.",
  "quelle": "daten"
 },
 {
  "de": "Huhnifizierer",
  "quelle": "daten"
 },
 {
  "de": "Verwandelt Gegner in Hühner. Die Hühnerkanone freut sich.",
  "quelle": "daten"
 },
 {
  "de": "Dudelsack des Grauens",
  "quelle": "daten"
 },
 {
  "de": "Klingt wie ein Pilzling, der in eine Tröte niest.",
  "quelle": "daten"
 },
 {
  "de": "Teleport-Toaster",
  "quelle": "daten"
 },
 {
  "de": "Der Toast erscheint direkt im Gegner. Frühstück ist serviert.",
  "quelle": "daten"
 },
 {
  "de": "Pflasterkanone",
  "quelle": "daten"
 },
 {
  "de": "Heilt Mitspieler. Gegner bekommen ein schlechtes Gewissen.",
  "quelle": "daten"
 },
 {
  "de": "Schildblasen",
  "quelle": "daten"
 },
 {
  "de": "Blasen kreisen um dich und schubsen Gegner weg.",
  "quelle": "daten"
 },
 {
  "de": "Glücksmünzen",
  "quelle": "daten"
 },
 {
  "de": "Klimpern im Kreis. Mehr Kristalle für alle.",
  "quelle": "daten"
 },
 {
  "de": "Kriegstrommel",
  "quelle": "daten"
 },
 {
  "de": "BUMM-BUMM-BUMM. Mitspieler in der Nähe feuern 15 % schneller.",
  "quelle": "daten"
 },
 {
  "de": "Kuckucksuhr",
  "quelle": "daten"
 },
 {
  "de": "KUCKUCK! Die Zeit friert für Gegner 1 s ein.",
  "quelle": "daten"
 },
 {
  "de": "Omas Keksdose",
  "quelle": "daten"
 },
 {
  "de": "Kekse regnen vom Himmel und heilen alle in der Nähe.",
  "quelle": "daten"
 },
 {
  "de": "Grummelbold",
  "quelle": "daten"
 },
 {
  "de": "Grummel-Fraktion",
  "quelle": "daten"
 },
 {
  "de": "„Grmpf. Meins!\"",
  "quelle": "daten"
 },
 {
  "de": "Grüner Kobold mit verbeultem Kochtopf als Helm. Grummelt beim Laufen und kommt nie allein.",
  "quelle": "daten"
 },
 {
  "de": "Bomben-Kröte",
  "quelle": "daten"
 },
 {
  "de": "Sumpfbande",
  "quelle": "daten"
 },
 {
  "de": "„Quaaak … KAWUMM!\"",
  "quelle": "daten"
 },
 {
  "de": "Dicke lila Kröte mit Glupschaugen und Bombe auf dem Rücken. Springt dir vor die Füße – und explodiert auch, wenn man sie erwischt.",
  "quelle": "daten"
 },
 {
  "de": "Toastomat",
  "quelle": "daten"
 },
 {
  "de": "Blechbrut",
  "quelle": "daten"
 },
 {
  "de": "„Frühstück ist serviert!\"",
  "quelle": "daten"
 },
 {
  "de": "Wütender Toaster auf Stelzenbeinen mit roten LED-Augenbrauen. Hält Abstand und schießt glühenden Toast.",
  "quelle": "daten"
 },
 {
  "de": "Kampfhuhn",
  "quelle": "daten"
 },
 {
  "de": "Hühner-Kult",
  "quelle": "daten"
 },
 {
  "de": "„BAGAWK!\"",
  "quelle": "daten"
 },
 {
  "de": "Ein Huhn mit Stirnband und sehr viel Wut. Scharrt kurz – und stürmt dann los wie ein gefiederter Torpedo.",
  "quelle": "daten"
 },
 {
  "de": "Vogelscheuche Stroh-Udo",
  "quelle": "daten"
 },
 {
  "de": "„Ich hab ein Herz aus Stroh – und das schlägt für meine Truppe!\"",
  "quelle": "daten"
 },
 {
  "de": "Hält Abstand und heilt mit wedelnden Armen alle Gegner in der Nähe. Zuerst ausschalten!",
  "quelle": "daten"
 },
 {
  "de": "Funkenkobold",
  "quelle": "daten"
 },
 {
  "de": "Funkenbande",
  "quelle": "daten"
 },
 {
  "de": "„Bzzzt! Hihi!\"",
  "quelle": "daten"
 },
 {
  "de": "Winzig, flink, statisch aufgeladen. Kommt immer im Schwarm und schießt kleine Funken.",
  "quelle": "daten"
 },
 {
  "de": "Tesla-Ritter",
  "quelle": "daten"
 },
 {
  "de": "„Mein Schild ist geladen – im wahrsten Sinne!\"",
  "quelle": "daten"
 },
 {
  "de": "Trägt einen Spulenschild. Treffer von vorne prallen fast wirkungslos ab – also: von der Seite oder mit Explosionen!",
  "quelle": "daten"
 },
 {
  "de": "Schrottgolem",
  "quelle": "daten"
 },
 {
  "de": "„KLONK. KLONK. KLONK.\"",
  "quelle": "daten"
 },
 {
  "de": "Ein wandelnder Schrotthaufen mit Kühlschranktür als Brust. Langsam, aber zäh wie Omas Schnitzel.",
  "quelle": "daten"
 },
 {
  "de": "Minenbot",
  "quelle": "daten"
 },
 {
  "de": "„Piep. Hier liegt was. Piep.\"",
  "quelle": "daten"
 },
 {
  "de": "Rollt herum und verteilt blinkende Minen. Nicht drauftreten – oder vorher abschießen.",
  "quelle": "daten"
 },
 {
  "de": "Pilzling",
  "quelle": "daten"
 },
 {
  "de": "„Pfff. Riechst du das? Das bin ich.\"",
  "quelle": "daten"
 },
 {
  "de": "Kleiner Stinkepilz mit roter Kappe und Schmollmund. Hinterlässt Giftwolken, wo er langläuft.",
  "quelle": "daten"
 },
 {
  "de": "Schleimi",
  "quelle": "daten"
 },
 {
  "de": "„Blubb. Blubb blubb.\"",
  "quelle": "daten"
 },
 {
  "de": "Ein grimmiger Glibberklops. Platzt man ihn, werden es zwei kleine. Die sind noch grimmiger.",
  "quelle": "daten"
 },
 {
  "de": "Schleimchen",
  "quelle": "daten"
 },
 {
  "de": "„Blubb!\"",
  "quelle": "daten"
 },
 {
  "de": "Halber Schleimi, doppelte Laune.",
  "quelle": "daten"
 },
 {
  "de": "Lavaklops",
  "quelle": "daten"
 },
 {
  "de": "Glutgesindel",
  "quelle": "daten"
 },
 {
  "de": "„Heiß, heißer, ich!\"",
  "quelle": "daten"
 },
 {
  "de": "Ein brodelnder Klumpen mit Grummelgesicht. Hinterlässt eine glühende Spur – nicht reintreten!",
  "quelle": "daten"
 },
 {
  "de": "Kawumm-Kultist",
  "quelle": "daten"
 },
 {
  "de": "„Oh großes Kawumm, schick uns Verstärkung!\"",
  "quelle": "daten"
 },
 {
  "de": "Verehrt das Große Kawumm. Hält Abstand und öffnet Portale, aus denen Grummelbolde purzeln.",
  "quelle": "daten"
 },
 {
  "de": "Schneemann Fritz",
  "quelle": "daten"
 },
 {
  "de": "Frostfrieder",
  "quelle": "daten"
 },
 {
  "de": "„Ich bin cool. Eiskalt sogar.\"",
  "quelle": "daten"
 },
 {
  "de": "Wirft pappige Schneebälle, die dich verlangsamen. Möhrennase gerümpft, Kohleaugen zusammengekniffen.",
  "quelle": "daten"
 },
 {
  "de": "Bombenpinguin",
  "quelle": "daten"
 },
 {
  "de": "„Wiiieeee – KAWUMM!\"",
  "quelle": "daten"
 },
 {
  "de": "Rutscht auf dem Bauch heran und explodiert beim Aufprall. Nimmt Anlauf: kurz Zeit zum Ausweichen!",
  "quelle": "daten"
 },
 {
  "de": "König Gockel der Laute",
  "quelle": "daten"
 },
 {
  "de": "„KIKERIKIIIII! Auf die Knie, Federlose!\"",
  "quelle": "daten"
 },
 {
  "de": "Riesiger Hahn mit Goldkrone und Umhang. Stürmt los, schleudert Federn im Kreis und ruft seine Kampfhühner.",
  "quelle": "daten"
 },
 {
  "de": "Toastomat 3000",
  "quelle": "daten"
 },
 {
  "de": "„FRÜHSTÜCK. FÜR. ALLE.\"",
  "quelle": "daten"
 },
 {
  "de": "Der große Bruder aller Toastomaten. Feuert Toast-Salven im Kreis, wirft Brotbomben und ruft Minenbots.",
  "quelle": "daten"
 },
 {
  "de": "Pilzkönigin Morchella",
  "quelle": "daten"
 },
 {
  "de": "„Ihr seid nur Dünger für mein Reich!\"",
  "quelle": "daten"
 },
 {
  "de": "Gewaltiger Pilz mit Spitzenkragen und Schmollmund. Lässt Giftsporen regnen und ruft Schleimis.",
  "quelle": "daten"
 },
 {
  "de": "Baron von Bumm",
  "quelle": "daten"
 },
 {
  "de": "Bummburg",
  "quelle": "daten"
 },
 {
  "de": "„Ich bin nicht dick, ich bin explosiv gebaut!\"",
  "quelle": "daten"
 },
 {
  "de": "Runder Bösewicht mit Zylinder, Monokel und Schnurrbart. Auf dem Hut brennt eine Bombe. Hat das Große Kawumm gezündet und ist sehr stolz darauf.",
  "quelle": "daten"
 },
 {
  "de": "Baronin Gackerella von Federstein",
  "quelle": "daten"
 },
 {
  "de": "„Gack! Man verneigt sich vor einer Dame, Federloser!\"",
  "quelle": "daten"
 },
 {
  "de": "Hochnäsige Riesenhenne mit Federhut und Lorgnette. Lässt Eier vom Himmel regnen, rauscht quer übers Feld und ruft ihre Kampfhühner.",
  "quelle": "daten"
 },
 {
  "de": "Baron Blitzbirne",
  "quelle": "daten"
 },
 {
  "de": "„Mir geht ein Licht auf – und dir gleich die Puste aus!\"",
  "quelle": "daten"
 },
 {
  "de": "Eitler Edelmann mit einer riesigen Glühbirne als Kopf und Frack voller Kabel. Lässt Blitze einschlagen und dreht sich im Kreuzfeuer.",
  "quelle": "daten"
 },
 {
  "de": "Baronin Schraubella",
  "quelle": "daten"
 },
 {
  "de": "„Ich ziehe dir die Schrauben an. Alle. Gleichzeitig.\"",
  "quelle": "daten"
 },
 {
  "de": "Elegante Blechdame mit Zahnrad-Krone und Schrauben-Monokel. Feuert Bolzenspiralen, streut Minen und ruft Minenbots.",
  "quelle": "daten"
 },
 {
  "de": "Baronin Sporella",
  "quelle": "daten"
 },
 {
  "de": "„Atme tief ein, Schätzchen. Ganz tief.\"",
  "quelle": "daten"
 },
 {
  "de": "Pilzbaronin mit Schleier aus Moos und einem Hut so groß wie ein Gartenteich. Verwandelt den Boden in Gifttümpel und pustet Sporenspiralen.",
  "quelle": "daten"
 },
 {
  "de": "Baron Glutbauch",
  "quelle": "daten"
 },
 {
  "de": "„Heiß? Ich? Ich bin glühend vor Wut!\"",
  "quelle": "daten"
 },
 {
  "de": "Kugelrunder Magma-Fürst mit glühendem Bauch und Schnauzbart aus Rauch. Springt mitten ins Getümmel und lässt Lava aus dem Boden schießen.",
  "quelle": "daten"
 },
 {
  "de": "Baronin Frostine von Bibberstein",
  "quelle": "daten"
 },
 {
  "de": "„Wie unhöflich, mir so warm zu kommen.\"",
  "quelle": "daten"
 },
 {
  "de": "Kühle Adlige im Eiskristall-Kleid mit Pelzkragen und Schneeflocken-Diadem. Wirft Eiszapfen-Fächer, die bremsen, und schlittert in hohem Tempo heran.",
  "quelle": "daten"
 },
 {
  "de": "Das Große Kawumm",
  "quelle": "daten"
 },
 {
  "de": "Urknall",
  "quelle": "daten"
 },
 {
  "de": "„KA… WUMM… KAAAAWUMMMM!!!\"",
  "quelle": "daten"
 },
 {
  "de": "Die Explosion, die Krawummia zerrissen hat – aufgewacht, wütend und so groß wie eine Scheune. Ein brodelnder Feuerball mit grimmigen Brauen und einer Lunte als Haarschopf. Die Arena zerbricht unter ihm.",
  "quelle": "daten"
