{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OVERBOOM",
  "version": "0.10.1",
  "identifier": "de.overboom.spiel",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../.." },
    "beforeBuildCommand": { "script": "npm run build:web", "cwd": "../.." }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OVERBOOM",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 450,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0b0814"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Arena-Chaos mit Waffen-Fusion",
    "longDescription": "OVERBOOM – 3D-Voxel-Arena-Roguelite mit Waffen-Fusion und Koop für 1–4 Spieler.",
    "copyright": "OVERBOOM",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "languages": ["German", "English"], "displayLanguageSelector": false, "installMode": "currentUser" }
    },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-", "dmg": { "windowSize": { "width": 600, "height": 380 } } },
    "linux": { "deb": { "section": "games" } }
  }
}
