{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@overboom/core": ["packages/core/src/index.ts"],
      "@overboom/data": ["packages/data/src/index.ts"],
      "@overboom/render": ["packages/render/src/index.ts"],
      "@overboom/ui": ["packages/ui/src/index.ts"],
      "@overboom/net": ["packages/net/src/index.ts"],
      "@overboom/platform": ["packages/platform/src/index.ts"],
      "@overboom/audio": ["packages/audio/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/web/src/**/*.ts"]
}
