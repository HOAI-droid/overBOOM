{
  "name": "overboom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OVERBOOM – 3D-Voxel-Arena-Roguelite mit Waffen-Fusion (Browser, später App)",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:single": "SINGLE=1 vite build --config apps/web/vite.config.ts",
    "build:artifact": "npm run build:single && python3 tools/to-artifact.py dist-single/index.html dist-single/overboom.html",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings packages/core/test/sim.test.ts",
    "balance": "node --experimental-strip-types --no-warnings packages/core/test/balance-bot.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
